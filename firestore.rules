rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'jsai6305@gmail.com';
    }
    match /portfolio/public {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /portfolioImages/{imageId} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
