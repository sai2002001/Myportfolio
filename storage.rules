rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'jsai6305@gmail.com';
    }
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 15 * 1024 * 1024;
      allow delete: if isAdmin();
    }
  }
}
